<?xml version="1.0" encoding="utf-8"?>
<!--
    图标前景：一台手机 + 左侧靠上的侧键 + 弹出来的照片。

    为什么要有手机：侧键本身只是一根黄条，没有参照物就看不出它是「按键」。
    有了手机轮廓，黄条落在左上边缘才读得出「这是机器侧面的那颗键」。
    一加的侧键就在左侧靠上，位置照着真机摆。

    几何（108x108 画布；可见区 18..90；安全区是以 54,54 为心、半径 33 的圆；
    遮罩圆半径 36）。三层都按像素统计验过，正圆和圆角方形遮罩下**都是 0% 被裁**：

      · 手机   32..66 x, 26..82 y，圆角 8   —— 离圆心最远 32.4
      · 侧键   27..34 x, 33..49 y，胶囊形   —— 离圆心最远 32.2，向左探出手机 5px
      · 照片   48..84 x, 34..70 y，圆角 8   —— 离圆心最远 32.9，向右探出手机 18px

    配色上只留一处黄：侧键。山和太阳都用品牌蓝，做成单色「照片」象形，
    这样黄色就是全图唯一的强调色，视线自然落到侧键上。

    手机是 38% 白（#61FFFFFF）而不是纯白：压到这个透明度之后，
    它和背景的对比度在渐变两端分别是 1.7:1 / 2.6:1，轮廓始终看得见，
    同时又明显比纯白的照片卡片暗，层次不会糊在一起。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 手机：半透明白，读作「屏幕」 -->
    <path
        android:fillColor="#61FFFFFF"
        android:pathData="M40,26 H58 A8,8 0 0 1 66,34 V74 A8,8 0 0 1 58,82 H40 A8,8 0 0 1 32,74 V34 A8,8 0 0 1 40,26 Z" />

    <!-- 侧键：左侧靠上，胶囊形，向左探出机身 -->
    <path
        android:fillColor="#FFFFD166"
        android:pathData="M30.5,33 A3.5,3.5 0 0 1 34,36.5 V45.5 A3.5,3.5 0 0 1 30.5,49 A3.5,3.5 0 0 1 27,45.5 V36.5 A3.5,3.5 0 0 1 30.5,33 Z" />

    <!-- 照片：纯白卡片，向右探出机身 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M56,34 H76 A8,8 0 0 1 84,42 V62 A8,8 0 0 1 76,70 H56 A8,8 0 0 1 48,62 V42 A8,8 0 0 1 56,34 Z" />

    <!-- 山 -->
    <path
        android:fillColor="#FF2B6CF6"
        android:pathData="M54,62 L62.5,48.5 L66.5,53.5 L69,49.5 L78,62 Z" />

    <!-- 太阳：和山同色。和山的间距留了 3.9px，缩到 48dp 也不会糊成一团 -->
    <path
        android:fillColor="#FF2B6CF6"
        android:pathData="M58.5,44.5 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0 z" />
</vector>
